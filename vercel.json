{
  "version": 2,
  "builds": [
    {
      "src": "api/student.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/student.js"
    },
    {
      "src": "/(.*\\.(css|js|png|jpg|jpeg|gif|ico|svg|xlsx|woff|woff2|ttf))",
      "dest": "/$1"
    },
    {
      "src": "/(index[234]?\\.html)",
      "dest": "/$1"
    },
    {
      "src": "/",
      "dest": "/index.html"
    }
  ]
}
